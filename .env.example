# Browser-safe public settings only. Copy this file to .env.local.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ENV=development
# Optional public VAPID key; private VAPID keys belong only in server secrets.
VITE_WEB_PUSH_PUBLIC_KEY=

# Supabase must trust the Clerk issuer. Approve each Clerk user ID in
# app_members before granting access. Never put service-role or Clerk
# secret keys in VITE_ variables; they belong in server secret storage.
